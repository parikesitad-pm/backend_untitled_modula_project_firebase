import { Request, Response, NextFunction } from 'express';
import { ZodSchema, ZodError } from 'zod';
import { BadRequestError, UnprocessableEntityError } from '../lib/errors';

export function validateBody(schema: ZodSchema, errorStatusCode = 400) {
  return (req: Request, _res: Response, next: NextFunction): void => {
    try {
      req.body = schema.parse(req.body);
      next();
    } catch (err) {
      if (err instanceof ZodError) {
        const details = err.errors.map((e) => ({
          field: e.path.join('.'),
          message: e.message,
        }));
        if (errorStatusCode === 422) {
          next(new UnprocessableEntityError('Validation failed', 'VALIDATION_ERROR', details));
        } else {
          next(new BadRequestError('Validation failed', 'VALIDATION_ERROR', details));
        }
        return;
      }
      next(err);
    }
  };
}


export function validateQuery(schema: ZodSchema) {
  return (req: Request, _res: Response, next: NextFunction): void => {
    try {
      req.query = schema.parse(req.query);
      next();
    } catch (err) {
      if (err instanceof ZodError) {
        const details = err.errors.map((e) => ({
          field: e.path.join('.'),
          message: e.message,
        }));
        next(new BadRequestError('Invalid query parameters', 'VALIDATION_ERROR', details));
        return;
      }
      next(err);
    }
  };
}

export function validateParams(schema: ZodSchema) {
  return (req: Request, _res: Response, next: NextFunction): void => {
    try {
      req.params = schema.parse(req.params);
      next();
    } catch (err) {
      if (err instanceof ZodError) {
        const details = err.errors.map((e) => ({
          field: e.path.join('.'),
          message: e.message,
        }));
        next(new BadRequestError('Invalid route parameters', 'VALIDATION_ERROR', details));
        return;
      }
      next(err);
    }
  };
}
