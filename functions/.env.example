# Environment Mode
NODE_ENV=production

# Firebase Admin Service Account Credentials (Production / Vercel)
FIREBASE_PROJECT_ID=untitled-modula-backend
FIREBASE_CLIENT_EMAIL=your-service-account@untitled-modula-backend.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Cloudinary Media Configuration (Server-only)
CLOUDINARY_CLOUD_NAME=xkhsmbmg
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=modula_question_images_signed
CLOUDINARY_ROOT_ASSET_FOLDER=untitled-modula

# Production CORS & Networking
# Comma-separated list of allowed origins. CLI/server-to-server requests without Origin header are always permitted.
ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
# Optional public API base URL (used for OpenAPI servers definition)
PUBLIC_API_BASE_URL=https://api.example.com

# Login Rate Limiting (Server-only Firestore-backed)
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
