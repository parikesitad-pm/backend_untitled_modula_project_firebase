{
  "name": "modula-backend-functions",
  "version": "0.2.0",
  "description": "MODULA Activity Backend - Firebase First",
  "author": "parikesitad-pm",
  "license": "MIT",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:validate": "tsx scripts/validate-openapi.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "express": "4.21.2",
    "firebase-admin": "13.1.0",
    "firebase-functions": "6.3.2",
    "swagger-ui-express": "5.0.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.13.9",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "supertest": "7.0.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  }
}
